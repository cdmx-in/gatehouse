# Password sign-in (on by default). Set GATEHOUSE_PASSWORD_LOGIN=false to turn it off once Google sign-in works.
GATEHOUSE_ADMIN_PASSWORD=change-me
# GATEHOUSE_ADMIN_USER=admin
# GATEHOUSE_PASSWORD_LOGIN=false

# Google sign-in. Create an OAuth client (type "Web application") in Google Cloud Console and
# register <GATEHOUSE_PUBLIC_URL>/auth/google/callback as an authorized redirect URI.
# GATEHOUSE_GOOGLE_CLIENT_ID=
# GATEHOUSE_GOOGLE_CLIENT_SECRET=
# Who may sign in: email addresses and/or whole domains, comma-separated.
# GATEHOUSE_GOOGLE_ALLOWED=yourcompany.com,someone@gmail.com
# GATEHOUSE_PUBLIC_URL=https://gatehouse.yourcompany.com

# Host address the container port is published on.
# GATEHOUSE_BIND=127.0.0.1:8787
